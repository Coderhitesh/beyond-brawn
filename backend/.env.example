# ---------- App ----------
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000
# Public URL of this API (used for local upload URLs)
API_PUBLIC_URL=https://api.beyondbrawn.store
TRUST_PROXY=0
RATE_LIMIT_MAX=1500

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/beyond_brawn

# ---------- Auth ----------
# min 32 chars in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ADMIN_SECRET=
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=12h
# Leave empty on localhost. In production set e.g. .beyondbrawn.in
COOKIE_DOMAIN=
# lax (same site / proxied) | none (cross-site, needs https)
COOKIE_SAMESITE=lax

# ---------- OTP ----------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- SMTP ----------
# If SMTP_HOST is empty, emails (incl. OTPs) are printed to the server console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Beyond Brawn <no-reply@beyondbrawn.in>"
ADMIN_NOTIFY_EMAIL=

# ---------- Cloudinary ----------
# If empty, uploads are stored on local disk in src/uploads (dev only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beyond-brawn

# ---------- Seed admin (local development) ----------
SEED_ADMIN_EMAIL=admin@beyondbrawn.in
SEED_ADMIN_PASSWORD=Admin@12345
