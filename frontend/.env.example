# Express API base URL (no trailing slash). Used by the Next.js server and by the /api proxy.
API_URL=https://api.beyondbrawn.store
NEXT_PUBLIC_API_URL=https://api.beyondbrawn.store
# Public URL of this storefront. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://beyondbrawn.store
